-    get_filename_component(MARIAN_GIT_DIR "${CMAKE_CURRENT_SOURCE_DIR}/../${MARIAN_GIT_DIR}" ABSOLUTE)
-  endif()
-endif(NOT IS_DIRECTORY ${MARIAN_GIT_DIR})
-
